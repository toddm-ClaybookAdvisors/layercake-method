        if key in (ord('w'), ord('W'), curses.KEY_UP):
            return 'w'
        elif key in (ord('s'), ord('S'), curses.KEY_DOWN):
            return 's'
        elif key in (ord('a'), ord('A'), curses.KEY_LEFT):
            return 'a'
        elif key in (ord('d'), ord('D'), curses.KEY_RIGHT):
            return 'd'
        elif key in (ord('q'), ord('Q')):
